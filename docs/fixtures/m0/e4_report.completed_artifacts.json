{
  "name": "e4_report_completed_artifacts",
  "endpoint": "E4",
  "kind": "request",
  "http_status": 200,
  "note": "completed(seq=3) 帶 pointer-first diff artifact（meta 只摘要、不 inline blob）",
  "payload": {
