// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MessageBubble default-prop snapshots (G5) > assistant bubble with markdown and a code fence 1`] = `
<div
  class="max-w-[90%] text-sm leading-[1.7] text-text-primary"
  data-testid="assistant-text"
>
  <div
    class="prose prose-invert prose-sm max-w-none"
  >
    <p>
      Run 
      <strong>
        this
      </strong>
      :
    </p>
    

    <pre>
      <code
        class="hljs language-js"
      >
        <span
          class="hljs-variable language_"
        >
          console
        </span>
        .
        <span
          class="hljs-title function_"
        >
          log
        </span>
        (
        <span
          class="hljs-string"
        >
          "hi"
        </span>
        )

      </code>
    </pre>
  </div>
</div>
`;

exports[`MessageBubble default-prop snapshots (G5) > user bubble 1`] = `
